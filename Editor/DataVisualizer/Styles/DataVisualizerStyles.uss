:root {
    font-size: var(--dataviz-font-size);
    --dataviz-font-size: 16px;
    --dataviz-font-size-secondary: 14px;
    --dataviz-font-size-caption: 12px;
    --dataviz-font-size-indicator: 10px;
    --dataviz-circle-size: 26px;
    --dataviz-text: white;
    --dataviz-muted: grey;
    --dataviz-accent: chocolate;
    --dataviz-on-accent: white;
    --dataviz-popover: rgba(0, 0, 0, 0.75);
    --dataviz-namespace: rgb(60, 60, 60);
    --dataviz-row: rgba(255, 255, 255, 0.1);
    --dataviz-border: rgba(128, 128, 128, 0.5);
    --dataviz-selection: green;
    --dataviz-selection-text: lightgreen;
    --dataviz-selected-row: rgba(0, 0, 0, 0.2);
    --dataviz-hover: rgba(200, 200, 200, 0.3);
    --dataviz-pane: rgba(0, 0, 0, 0.4);
    --dataviz-control: transparent;
    --dataviz-control-hover: chocolate;
    --dataviz-control-pressed: #8b4513;
    --dataviz-background: #383838;
    --dataviz-input: #212121;
    --dataviz-danger: rgb(230, 102, 102);
    --dataviz-on-danger: #212121;
    --dataviz-positive: #66b366;
    --dataviz-on-positive: #152315;
    --dataviz-secondary: rgb(51, 153, 230);
    --dataviz-on-secondary: #102331;
    --dataviz-warning: goldenrod;
    --dataviz-on-warning: #29210d;
    --dataviz-emphasis: coral;
    --dataviz-on-emphasis: #30180f;
    --dataviz-control-padding: 6px;
    --dataviz-control-radius: 6px;
}

.dataviz-root {
    background-color: var(--dataviz-background);
    color: var(--dataviz-text);
}

.dataviz-root * {
    --unity-selection-color: var(--dataviz-selected-row);
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
}

.dataviz-root Button {
    background-color: var(--dataviz-control);
    border-color: var(--dataviz-border);
    color: var(--dataviz-text);
}

.dataviz-root Button:hover {
    background-color: var(--dataviz-control-hover);
    color: var(--dataviz-on-accent);
}

.dataviz-root Button:focus {
    border-color: var(--dataviz-accent);
}

.dataviz-root Button:active {
    background-color: var(--dataviz-control-pressed);
    color: var(--dataviz-on-accent);
}

.dataviz-root Button:disabled {
    opacity: 0.5;
}

.dataviz-root .unity-base-text-field__input,
.dataviz-root .unity-popup-field__input,
.dataviz-root .unity-enum-field__input,
.dataviz-root .unity-object-field__input {
    background-color: var(--dataviz-input);
    border-color: var(--dataviz-border);
    color: var(--dataviz-text);
    --unity-cursor-color: var(--dataviz-text);
}

.dataviz-root .unity-base-field__label,
.dataviz-root .unity-object-field-display,
.dataviz-root .unity-popup-field__text,
.dataviz-root .unity-enum-field__text,
.dataviz-root .unity-toggle__text,
.dataviz-root .unity-foldout__text {
    color: var(--dataviz-text);
}

.dataviz-root .unity-base-text-field__input:hover,
.dataviz-root .unity-popup-field__input:hover,
.dataviz-root .unity-enum-field__input:hover,
.dataviz-root .unity-object-field__input:hover {
    border-color: var(--dataviz-secondary);
}

.dataviz-root .unity-base-text-field__input:focus,
.dataviz-root .unity-base-text-field:focus > .unity-base-text-field__input,
.dataviz-root .unity-popup-field:focus > .unity-popup-field__input,
.dataviz-root .unity-enum-field:focus > .unity-enum-field__input,
.dataviz-root .unity-object-field:focus > .unity-object-field__input {
    border-color: var(--dataviz-accent);
}

.dataviz-root .unity-base-field:disabled > .unity-base-field__label,
.dataviz-root .unity-base-text-field:disabled > .unity-base-text-field__input,
.dataviz-root .unity-object-field:disabled .unity-object-field-display,
.dataviz-root .unity-popup-field:disabled .unity-popup-field__text,
.dataviz-root .unity-enum-field:disabled .unity-enum-field__text {
    color: var(--dataviz-muted);
}

.dataviz-root .unity-object-field__selector,
.dataviz-root .unity-scroller,
.dataviz-root .unity-foldout__toggle {
    background-color: var(--dataviz-control);
    border-color: var(--dataviz-border);
}

.dataviz-root .unity-object-field__selector:hover,
.dataviz-root .unity-foldout__toggle:hover {
    background-color: var(--dataviz-hover);
}

.dataviz-root .unity-toggle__checkmark {
    background-color: var(--dataviz-input);
    border-color: var(--dataviz-border);
    -unity-background-image-tint-color: var(--dataviz-text);
}

.dataviz-root .unity-toggle:hover .unity-toggle__checkmark,
.dataviz-root .unity-toggle:focus .unity-toggle__checkmark {
    border-color: var(--dataviz-accent);
}

.dataviz-root .unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--dataviz-accent);
    border-color: var(--dataviz-accent);
    -unity-background-image-tint-color: var(--dataviz-on-accent);
}

.dataviz-root .unity-toggle:disabled .unity-toggle__checkmark {
    opacity: 0.5;
}

.dataviz-root .unity-foldout__toggle .unity-toggle__checkmark,
.dataviz-root .unity-foldout__toggle:checked .unity-toggle__checkmark {
    background-color: transparent;
    border-color: transparent;
    -unity-background-image-tint-color: var(--dataviz-text);
}

.dataviz-root .unity-foldout__toggle:focus .unity-toggle__checkmark,
.dataviz-root .unity-foldout__toggle:hover .unity-toggle__checkmark {
    -unity-background-image-tint-color: var(--dataviz-accent);
}

.dataviz-root .unity-base-slider__tracker {
    background-color: var(--dataviz-input);
    border-color: var(--dataviz-border);
}

.dataviz-root .unity-base-slider__dragger {
    background-color: var(--dataviz-border);
    border-color: var(--dataviz-muted);
}

.dataviz-root .unity-base-slider__dragger:hover,
.dataviz-root .unity-base-slider:focus .unity-base-slider__dragger {
    background-color: var(--dataviz-accent);
    border-color: var(--dataviz-accent);
}

.dataviz-root .unity-base-slider__dragger:active {
    background-color: var(--dataviz-control-pressed);
}

.dataviz-root .unity-scroller__low-button,
.dataviz-root .unity-scroller__high-button {
    background-color: var(--dataviz-control);
    border-color: var(--dataviz-border);
    -unity-background-image-tint-color: var(--dataviz-text);
}

.dataviz-root .unity-scroller__low-button:hover,
.dataviz-root .unity-scroller__high-button:hover {
    background-color: var(--dataviz-control-hover);
    -unity-background-image-tint-color: var(--dataviz-on-accent);
}

.dataviz-root .unity-scroller__low-button:active,
.dataviz-root .unity-scroller__high-button:active {
    background-color: var(--dataviz-control-pressed);
    -unity-background-image-tint-color: var(--dataviz-on-accent);
}

.dataviz-root .unity-scroller:disabled {
    opacity: 0.5;
}

.dataviz-root .unity-inspector-element,
.dataviz-root .unity-list-view__header,
.dataviz-root .unity-list-view__footer,
.dataviz-root .unity-help-box {
    background-color: var(--dataviz-namespace);
    border-color: var(--dataviz-border);
    color: var(--dataviz-text);
}

.dataviz-root .unity-help-box__text {
    color: var(--dataviz-text);
}

.dataviz-root .dataviz-muted {
    color: var(--dataviz-muted);
}

.dataviz-root .dataviz-error {
    color: var(--dataviz-danger);
}

.dataviz-root .dataviz-divider {
    border-color: var(--dataviz-border);
}

.dataviz-root .dataviz-separator {
    background-color: var(--dataviz-border);
}

.dataviz-root .dataviz-suggestion {
    background-color: transparent;
    color: var(--dataviz-text);
}

.dataviz-root .dataviz-suggestion:hover,
.dataviz-root .dataviz-suggestion:focus {
    background-color: var(--dataviz-hover);
}

.dataviz-root .transparent-cursor,
.dataviz-root .transparent-cursor .unity-base-text-field__input {
    --unity-cursor-color: transparent;
}

.styled-cursor {
    --unity-cursor-color: var(--dataviz-text);
}

.object-item {
    padding: 4px 8px;
    margin: 2px 0;
    border-color: var(--dataviz-border);
    border-radius: 3px;
    background-color: var(--dataviz-row);
    border-width: 2px;
}

.object-item__label {
    flex-grow: 1;
    -unity-text-align: middle-left;
    align-content: center;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 5px;
    margin-left: 5px;
}

.bold {
    -unity-font-style: bold;
}

.popover {
    margin-top: 2px;
    position: absolute;
    min-width: 200px;
    min-height: 50px;
    max-width: 500px;
    background-color: var(--dataviz-popover);
    border-radius: 10px;
    border-width: 0;
    display: none;
    flex-direction: column;
    padding: 10px;
    color: var(--dataviz-text);
}

.rename-object-label {
    margin-bottom: 5px;
}

.rename-text-field > #unity-text-input {
    margin-bottom: 5px;
    border-radius: 5px;
    padding: 2px 6px;
    background-color: var(--dataviz-input);
    --unity-selection-color: var(--dataviz-selected-row);
    border-color: var(--dataviz-secondary);
    color: var(--dataviz-text);
    border-width: 2px;
}

.create-text-field > #unity-text-input {
    margin-bottom: 5px;
    border-radius: 5px;
    padding: 2px 6px;
    background-color: var(--dataviz-input);
    --unity-selection-color: var(--dataviz-selected-row);
    border-color: var(--dataviz-positive);
    color: var(--dataviz-text);
    border-width: 2px;
}

.dataviz-root .popover-button {
    color: var(--dataviz-text);
    padding: 2px 6px;
    font-size: var(--dataviz-font-size);
    border-width: 2px;
    border-radius: 10px;
    margin-bottom: 2px;
}

.dataviz-root .popover-delete-button {
    border-color: var(--dataviz-danger);
}

.dataviz-root .popover-delete-button:hover,
.dataviz-root .popover-delete-button:focus,
.dataviz-root .popover-delete-button:active {
    background-color: var(--dataviz-danger);
    border-color: var(--dataviz-danger);
    color: var(--dataviz-on-danger);
}

.dataviz-root .popover-rename-button {
    border-color: var(--dataviz-secondary);
}

.dataviz-root .popover-rename-button:hover,
.dataviz-root .popover-rename-button:focus,
.dataviz-root .popover-rename-button:active {
    background-color: var(--dataviz-secondary);
    border-color: var(--dataviz-secondary);
    color: var(--dataviz-on-secondary);
}

.dataviz-root .popover-create-button {
    border-color: var(--dataviz-positive);
}

.dataviz-root .popover-create-button:hover,
.dataviz-root .popover-create-button:focus,
.dataviz-root .popover-create-button:active {
    background-color: var(--dataviz-positive);
    border-color: var(--dataviz-positive);
    color: var(--dataviz-on-positive);
}

.popover-drag-handle {
    height: 20px;
    margin-bottom: 5px;
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: transparent;
}

.popover-drag-handle.settings {
    color: var(--dataviz-accent);
}

.popover-drag-handle.create {
    color: var(--dataviz-positive);
}

.popover-drag-handle.namespace-add {
    color: var(--dataviz-positive);
}

.popover-drag-handle.rename {
    color: var(--dataviz-secondary);
}

.popover-drag-handle.confirm-delete {
    color: var(--dataviz-danger);
}

.popover-drag-handle > .unity-text-element {
    background-color: transparent;
}

.dataviz-root .popover-cancel-button {
    border-color: var(--dataviz-warning);
    margin-right: 10px;
}

.dataviz-root .popover-confirm-button {
    border-color: var(--dataviz-positive);
    margin-right: 10px;
}

.dataviz-root .popover-confirm-button:hover,
.dataviz-root .popover-confirm-button:focus,
.dataviz-root .popover-confirm-button:active {
    border-color: var(--dataviz-positive);
    background-color: var(--dataviz-positive);
    color: var(--dataviz-on-positive);
}

.dataviz-root .popover-cancel-button:hover,
.dataviz-root .popover-cancel-button:focus,
.dataviz-root .popover-cancel-button:active {
    border-color: var(--dataviz-warning);
    background-color: var(--dataviz-warning);
    color: var(--dataviz-on-warning);
}

.dataviz-root .popover-close-button {
    color: var(--dataviz-danger);
    -unity-font-style: bold;
    padding: 10px 5px;
    font-size: var(--dataviz-font-size);
    border-width: 2px;
    border-color: var(--dataviz-danger);
    border-radius: 50%;
}

.search-popover {
    position: absolute;
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    max-height: 500px;
    background-color: var(--dataviz-popover);
    border-width: 2px;
    border-radius: 8px;
    margin-top: 2px;
    border-color: var(--dataviz-popover);
    display: none;
}

.types-container {
    margin-left: 10px;
}

.clickable:hover {
    cursor: link;
}

.object-item:hover {
    background-color: var(--dataviz-hover);
    border-color: var(--dataviz-selection);
}

.object-item.selected {
    color: var(--dataviz-selection-text);
    background-color: var(--dataviz-selected-row);
    border-color: var(--dataviz-selection);
}

.drag-ghost {
    position: absolute;
    border-width: 1px;
    border-color: var(--dataviz-text);
    background-color: var(--dataviz-popover);
    border-radius: 3px;
    padding: 4px 8px;
    opacity: 0.8;
}

.drop-indicator {
    position: absolute;
    height: 2px;
    background-color: var(--dataviz-secondary);
    width: 100%;
}

.namespace-item {
    padding: 4px 8px;
    margin: 6px;
    margin-bottom: 0;
    color: var(--dataviz-muted);
    border-color: var(--dataviz-border);
    background-color: var(--dataviz-namespace);
    border-radius: 10px;
    border-width: 2px;
}

.namespace-item:hover {
    border-color: var(--dataviz-selection-text);
}

.namespace-item.selected {
    color: var(--dataviz-text);
    border-color: var(--dataviz-selection);
}

.namespace-item__label {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 5px;
    margin-left: 5px;
    height: 20px;
}

.namespace-header-right {
    flex-shrink: 0;
}

.namespace-delete-button {
    margin-right: 9px;
}

.type-item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-left: 10px;
    padding: 4px 6px;
    border-radius: 6px;
    color: var(--dataviz-text);
    margin-top: 0;
    margin-bottom: 6px;
    border-width: 2px;
    border-color: var(--dataviz-border);
    background-color: var(--dataviz-row);
}

.type-item:hover {
    background-color: transparent;
    border-color: var(--dataviz-selection-text);
    cursor: link;
}

.type-item.selected {

}

.type-item__label {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-right: 5px;
    margin-left: 5px;
    height: 20px;
}

.type-item.selected {
    background-color: var(--dataviz-selected-row);
    border-color: var(--dataviz-selection);
}

.type-item--disabled {
    opacity: 0.5;
    background-color: var(--dataviz-row);
}

.in-place-ghost {
    opacity: 0.5;
    border-width: 1px;
    border-color: var(--dataviz-muted);
}

.overlay-ghost {
    position: absolute;
    opacity: 0.5;
    border-width: 1px;
    border-color: var(--dataviz-secondary);
    background-color: var(--dataviz-selected-row);
}

.namespace-group-header {
    flex-direction: row;
    justify-content: space-between;
    -unity-font-style: bold;
    align-items: center;
    padding: 3px;
    height: 42px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--dataviz-border);
}

.namespace-group-header > .unity-label {
    margin-left: 6px;
}

.namespace-group-header > .unity-button {
    margin-right: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.namespace-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 4px;
    padding-left: 2px;
    padding-right: 2px;
}

.namespace-indicator {
    width: 16px;
    font-size: var(--dataviz-font-size-indicator);
    margin-right: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.object-item {
    color: var(--dataviz-text);
    min-width: 0;
    background-color: var(--dataviz-row);
    border-radius: 6px;
    margin: 0 2px;
    overflow: hidden;
}

.object-item-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 24px;
    overflow: hidden;
}

.object-item-actions {
    flex-shrink: 0;
}

.object-header {
    flex-direction: row;
    justify-content: space-between;
    -unity-font-style: bold;
    align-items: center;
    padding: 3px;
    height: 42px;
    flex-shrink: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--dataviz-border);
}

.object-header > .unity-label {
    margin-left: 6px;
}

.object-header > .unity-button {
    margin-right: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.object-scrollview {
    flex-grow: 1;
}

/* Descendant (not direct-child): the virtualized ListView nests its scroll container deeper than a
   raw ScrollView did, so match at any depth to keep the dark, uniform backdrop behind the rows. */
.object-scrollview .unity-scroll-view__content-and-vertical-scroll-container {
    background-color: var(--dataviz-pane);
}

/* Hide the Animated reorder-mode drag handle and collapse the gutter its container reserves, so the
   rows use the full width; the whole row stays draggable. Row-box centering is handled in code by a
   transparent outer slot (MakeObjectRow). */
.object-scrollview .unity-list-view__reorderable-handle {
    display: none;
    width: 0;
    min-width: 0;
}

.object-scrollview .unity-list-view__reorderable-item__container {
    padding-left: 0;
    padding-right: 0;
}

/* Suppress the ListView's own full-width selection/hover fill so only the per-row box's green
   .object-item.selected border/background reads as selected. */
.object-scrollview .unity-collection-view__item--selected {
    background-color: transparent;
}

.object-scrollview .unity-collection-view__item:hover {
    background-color: transparent;
}

.namespace-scrollview {
    flex-grow: 1;
}

.namespace-scrollview > .unity-scroll-view__content-and-vertical-scroll-container {
    background-color: var(--dataviz-pane);
}

.action-button {
    flex-shrink: 0;
    font-size: var(--dataviz-font-size-secondary);
    width: var(--dataviz-circle-size);
    height: var(--dataviz-circle-size);
    min-width: var(--dataviz-circle-size);
    min-height: var(--dataviz-circle-size);
    padding: 0;
    background-color: transparent;
    border-radius: 50%;
    border-width: 2px;
    -unity-font-style: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
}

.icon-button,
.go-button-disabled {
    width: var(--dataviz-circle-size);
    height: var(--dataviz-circle-size);
    min-width: var(--dataviz-circle-size);
    min-height: var(--dataviz-circle-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 50%;
    -unity-text-align: middle-center;
}

.go-button-disabled {
    flex-shrink: 0;
    font-size: var(--dataviz-font-size-secondary);
    background-color: transparent;
    border-width: 2px;
    -unity-font-style: bold;
    border-color: var(--dataviz-muted);
    color: var(--dataviz-muted);
    -unity-text-align: middle-center;
}

.dataviz-root .action-button {
    background-color: transparent;
}

.dataviz-root .action-button:hover {
    cursor: link;
    background-color: var(--dataviz-hover);
}

.selected.action-button {
    -unity-font-style: bold;
}

.dataviz-root .selected.action-button:hover {
    background-color: var(--dataviz-hover);
    border-color: var(--dataviz-selection);
}

.dataviz-root .go-button {
    border-color: var(--dataviz-text);
    color: var(--dataviz-text);
}

.dataviz-root .go-button:hover,
.dataviz-root .go-button:focus,
.dataviz-root .go-button:active {
    background-color: var(--dataviz-accent);
    border-color: var(--dataviz-accent);
    color: var(--dataviz-on-accent);
}

.dataviz-root .create-button {
    -unity-font-style: bold;
    color: var(--dataviz-on-positive);
    background-color: var(--dataviz-positive);
    border-color: var(--dataviz-text);
    border-width: 2px;
    font-size: var(--dataviz-circle-size);
    border-radius: 50%;
    width: var(--dataviz-circle-size);
    height: var(--dataviz-circle-size);
    min-width: var(--dataviz-circle-size);
    min-height: var(--dataviz-circle-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    padding-bottom: 3px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.dataviz-root .create-button:hover,
.dataviz-root .create-button:focus,
.dataviz-root .create-button:active {
    background-color: var(--dataviz-on-positive);
    color: var(--dataviz-positive);
    border-color: var(--dataviz-positive);
}

.dataviz-root .load-from-data-folder-button {
    -unity-font-style: bold;
    color: var(--dataviz-on-accent);
    background-color: var(--dataviz-accent);
    border-color: var(--dataviz-text);
    border-width: 2px;
    font-size: var(--dataviz-circle-size);
    border-radius: 50%;
    width: var(--dataviz-circle-size);
    height: var(--dataviz-circle-size);
    min-width: var(--dataviz-circle-size);
    min-height: var(--dataviz-circle-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    padding-bottom: 3px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.dataviz-root .load-from-data-folder-button:hover,
.dataviz-root .load-from-data-folder-button:focus,
.dataviz-root .load-from-data-folder-button:active {
    background-color: var(--dataviz-input);
    color: var(--dataviz-accent);
    border-color: var(--dataviz-accent);
}

.dataviz-root .load-from-script-folder-button {
    -unity-font-style: bold;
    color: var(--dataviz-on-secondary);
    background-color: var(--dataviz-secondary);
    border-color: var(--dataviz-text);
    border-width: 2px;
    font-size: var(--dataviz-circle-size);
    border-radius: 50%;
    width: var(--dataviz-circle-size);
    height: var(--dataviz-circle-size);
    min-width: var(--dataviz-circle-size);
    min-height: var(--dataviz-circle-size);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    padding-bottom: 3px;
    margin-bottom: 2px;
    -unity-text-align: middle-center;
}

.dataviz-root .load-from-script-folder-button:hover,
.dataviz-root .load-from-script-folder-button:focus,
.dataviz-root .load-from-script-folder-button:active {
    background-color: var(--dataviz-on-secondary);
    color: var(--dataviz-secondary);
    border-color: var(--dataviz-secondary);
}

.dataviz-root .delete-button {
    border-color: var(--dataviz-danger);
    color: var(--dataviz-danger);
}

.dataviz-root .delete-button:hover,
.dataviz-root .delete-button:focus,
.dataviz-root .delete-button:active,
.dataviz-root .popover-close-button:hover,
.dataviz-root .popover-close-button:focus,
.dataviz-root .popover-close-button:active {
    background-color: var(--dataviz-danger);
    border-color: var(--dataviz-danger);
    color: var(--dataviz-on-danger);
}

.dataviz-root .clone-button {
    border-color: var(--dataviz-positive);
    color: var(--dataviz-positive);
}

.dataviz-root .clone-button:hover,
.dataviz-root .clone-button:focus,
.dataviz-root .clone-button:active {
    background-color: var(--dataviz-positive);
    border-color: var(--dataviz-positive);
    color: var(--dataviz-on-positive);
}

.dataviz-root .move-button {
    border-color: var(--dataviz-warning);
    color: var(--dataviz-warning);
}

.dataviz-root .move-button:hover,
.dataviz-root .move-button:focus,
.dataviz-root .move-button:active {
    background-color: var(--dataviz-warning);
    border-color: var(--dataviz-warning);
    color: var(--dataviz-on-warning);
}

.dataviz-root .rename-button {
    background-color: transparent;
    border-color: var(--dataviz-secondary);
    color: var(--dataviz-secondary);
}

.dataviz-root .rename-button:hover,
.dataviz-root .rename-button:focus,
.dataviz-root .rename-button:active {
    background-color: var(--dataviz-secondary);
    border-color: var(--dataviz-secondary);
    color: var(--dataviz-on-secondary);
}

.namespace-group-item--empty {
    opacity: 0.6;
}

.global-search-field {
    flex-grow: 1;
    margin-right: 10px;
    border-radius: 4px;
}

.type-search-field {
    flex-grow: 0;
    flex-shrink: 0;
    height: 24px;
    min-height: 24px;
    margin: 5px;
    border-radius: 4px;
}

.type-search-field > #unity-text-input {
    border-top-right-radius: 0;
    height: 100%;
    min-height: 0;
}

.empty-object-list-label {
    color: var(--dataviz-muted);
    white-space: normal;
    margin: 10px;
}

.type-selection-list-item {
    margin-left: 15px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 2px 5px;
    background-color: transparent;
    border-radius: 5px;
    flex-grow: 0;
    flex-shrink: 0;
    height: 24px;
    min-height: 24px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.type-selection-list-item:hover {
    color: var(--dataviz-text);
    background-color: var(--dataviz-hover);
}

.type-selection-list-item--disabled {
    opacity: 0.5;
}

.type-selection-list-namespace {
    margin-top: 8px;
    margin-left: 5px;
    margin-bottom: 2px;
    padding: 2px 6px;
    -unity-font-style: bold;
    flex-shrink: 1;
    height: 28px;
    min-height: 28px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-width: 2px;
    border-radius: 5px;
    border-color: transparent;
}

.type-selection-list-namespace--not-empty {
    border-color: var(--dataviz-text);
    color: var(--dataviz-text);
}

.type-selection-list-namespace--not-empty:hover {
    border-color: var(--dataviz-selection-text);
}

.type-selection-list-namespace--empty {
    color: var(--dataviz-muted);
}

.dataviz-root .unity-text-field__placeholder > .unity-base-text-field__input,
.dataviz-root .unity-base-text-field__input--placeholder {
    color: var(--dataviz-muted);
}

.popover-namespace-header {
    flex-direction: row;
    align-items: center;
    padding: 0 2px;
    -unity-font-style: bold;
    background-color: transparent;
    border-radius: 5px;
    border-width: 2px;
    border-color: transparent;
}

.popover-namespace-indicator {
    padding-top: 6px;
    font-size: var(--dataviz-font-size-indicator);
}

.search-result-item {
    border-radius: 6px;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.search-result-item:hover {
    background-color: var(--dataviz-hover);
    color: var(--dataviz-text);
}

.search-result-item--highlighted {
    background-color: var(--dataviz-hover);
    color: var(--dataviz-text);
}

.search-result-type-label {
    -unity-text-align: middle-right;
    font-size: var(--dataviz-font-size-caption);
    flex-shrink: 0;
}

.search-result-context-label {
    font-size: var(--dataviz-font-size-secondary);
    color: var(--dataviz-muted);
    margin-left: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.popover-button-container {
    flex-direction: row;
    justify-content: flex-end;
}

.search-result-name-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
    margin-right: 10px;
}

.type-add-search-field {
    flex-shrink: 0;
    height: 24px;
    min-height: 24px;
    margin: 4px;
    margin-bottom: 2px;
    border-radius: 8px;
}

.type-add-search-field > #unity-text-input {
    border-color: transparent;
    height: 100%;
    min-height: 0;
}

.type-add-search-field > #unity-text-input > .unity-text-element {
    padding: 0 4px;
}

.popover-item--highlighted {
    background-color: var(--dataviz-hover);
    color: var(--dataviz-text);
}

.popover-item--highlighted > .type-selection-list-namespace--not-empty {
    color: var(--dataviz-text);
    border-color: transparent;
}

.dataviz-root .readonly-display-field > .unity-base-text-field__input {
    color: var(--dataviz-muted);
    background-color: transparent;
    border-width: 0;
}

.readonly-display-field .unity-label {
    opacity: 1 !important;
}

.dataviz-root .settings-button {
    /*
        Kept at fixed 26px: the padding-bottom offset that raises the glyph
        is tuned to this size and would clip the glyph at smaller circle
        sizes, so this control does not follow the density tokens.
    */
    font-size: 26px;
    padding: 2px 6px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    padding-bottom: 18px;
    color: var(--dataviz-on-accent);
    background-color: var(--dataviz-accent);
    border-color: var(--dataviz-text);
    border-width: 2px;
}

.dataviz-root .settings-button:hover,
.dataviz-root .settings-button:focus,
.dataviz-root .settings-button:active {
    color: var(--dataviz-accent);
    background-color: var(--dataviz-input);
    border-color: var(--dataviz-accent);
}

.settings-data-folder-path-display {
    flex-grow: 1;
    flex-shrink: 1;
}

.settings-data-folder-path-display.unity-label {
    color: var(--dataviz-muted);
    padding: 0 6px;
    margin: 0 4px;
    border-radius: 5px;
    -unity-font-style: italic;
    flex-shrink: 1;
    flex-grow: 1;
    background-color: transparent;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: var(--dataviz-muted);
}

.settings-data-folder-label {
    flex-grow: 0;
    flex-shrink: 0;
}

.type-add-popover {
    position: absolute;
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    max-height: 500px;
    background-color: var(--dataviz-popover);
    border-width: 2px;
    border-radius: 8px;
    margin-top: 2px;
    border-color: var(--dataviz-popover);
    display: none;
}

.type-add-popover-scrollview {
    width: auto;
    flex-grow: 1;
    flex-shrink: 1;
}

.type-add-list-container {

}

.theme-dropdown-title {
    padding: 6px 8px 2px 8px;
    color: var(--dataviz-accent);
    -unity-font-style: bold;
    font-size: var(--dataviz-font-size);
}

.theme-search-result {
    text-overflow: ellipsis;
    overflow: hidden;
}

.theme-search-result:hover,
.theme-search-result:focus {
    background-color: var(--dataviz-hover);
}

.theme-search-empty {
    padding: 8px;
    color: var(--dataviz-muted);
}

.theme-field {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 4px;
}

.dataviz-root .theme-field,
.dataviz-root .theme-reset-button,
.dataviz-root .settings-data-folder-button {
    font-size: var(--dataviz-font-size);
    border-radius: var(--dataviz-control-radius);
    margin-right: 0;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: transparent;
    color: var(--dataviz-accent);
    border-color: var(--dataviz-accent);
    border-width: 2px;
}

.dataviz-root .theme-field:hover,
.dataviz-root .theme-field:focus,
.dataviz-root .theme-reset-button:hover,
.dataviz-root .theme-reset-button:focus,
.dataviz-root .settings-data-folder-button:hover,
.dataviz-root .settings-data-folder-button:focus {
    color: var(--dataviz-on-accent);
    background-color: var(--dataviz-accent);
}

.dataviz-root .theme-field:active,
.dataviz-root .theme-reset-button:active,
.dataviz-root .settings-data-folder-button:active {
    color: var(--dataviz-on-accent);
    background-color: var(--dataviz-control-pressed);
}

.settings-prefs-toggle > .unity-text-element {
    color: var(--dataviz-text);
    font-size: var(--dataviz-font-size);
}

.settings-prefs-toggle > .unity-toggle__input {
}

.action-button-toggle {
    align-self: flex-end;
}

.dataviz-root .action-button-toggle__button {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--dataviz-input);
    border-color: var(--dataviz-muted);
    color: var(--dataviz-text);
    border-width: 4px;
    background-image: none;
}

.dataviz-root .action-button-toggle__button--on {
    background-color: var(--dataviz-accent);
    border-color: var(--dataviz-accent);
    color: var(--dataviz-on-accent);
}

.dataviz-root .action-button-toggle__button:hover {
    border-color: var(--dataviz-text);
}

.dataviz-root .action-button-toggle__button:active {
    background-color: var(--dataviz-control-pressed);
}

.dataviz-root .action-button-toggle:disabled {
    opacity: 0.5;
}

.dataviz-root .add-label-button {
    min-height: 24px;
    font-size: var(--dataviz-font-size);
    -unity-font-style: bold;
    color: var(--dataviz-on-positive);
    background-color: var(--dataviz-positive);
    border-width: 0;
    margin: 6px 8px 2px 0;
    border-radius: 4px;
    padding: 0 24px;
    align-self: center;
}

.dataviz-root .add-label-button:hover,
.dataviz-root .add-label-button:focus,
.dataviz-root .add-label-button:active {
    background-color: var(--dataviz-on-positive);
    color: var(--dataviz-positive);
    border-color: var(--dataviz-positive);
}

.collapse-row {
    flex-direction: row;
    background-color: var(--dataviz-pane);
}

.labels-label {
    padding-top: 6px;
    padding-bottom: 2px;
    -unity-font-style: bold;
}

.collapse-toggle {
    height: 22px;
    width: 22px;
    -unity-font-style: bold;
    align-self: flex-start;
    margin-left: 6px;
    margin-top: 6px;
    margin-right: 6px;
}

.label-container-container {
    background-color: var(--dataviz-pane);
}

.label-filter-section-root {
    padding: 2px;
}

.label-pill {
    cursor: pan;
    padding: 0 4px;
    height: 22px;
    margin: 2px;
    flex-direction: row;
    align-items: center;
    border-width: 0;
    border-radius: 3px;
    -unity-text-align: middle-center;
    min-width: 0;
}

.label-pill.non-draggable {
    cursor: arrow;
}

.label-pill-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: 4px;
    min-height: 36px;
    padding: 4px;
    border-color: var(--dataviz-border);
    border-width: 1px;
    border-radius: 6px;
    min-width: 100px;
    background-color: var(--dataviz-namespace);
}

.label-header {
    margin: 0 4px;
    -unity-text-align: middle-right;
}

.label-row-container {
    flex-direction: row;
    align-items: center;
    margin: 4px 0;
}

.label-row-container--available {
    align-self: center;
}

.label-pill-remove-button {
    font-size: var(--dataviz-font-size);
    -unity-font-style: bold;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0 4px 2px 1px;
    align-self: center;
}

.advanced-row {
    flex-direction: row;
    align-items: center;
}

.collapse-toggle.advanced {
    margin-top: 0;
    -unity-font-style: normal;
}

.drop-target-hover {
    background-color: var(--dataviz-selected-row);
}

.label-pill-container.clickable {
    cursor: move-arrow;
}

.label-pill-container:active {
    cursor: slide-arrow;
}

.label-logical-grouping {
    padding: 0;
    margin: 0 4px;
    border-radius: 6px;
}

.processor-button {
    margin: 2px 4px;
    padding: 0 4px;
    border-radius: 3px;
    -unity-text-align: middle-center;
}

.processor-column {
    flex-direction: column;
    border-right-width: 1px;
    padding: 0;
}

.processor-list-container {
    border-color: var(--dataviz-border);
    background-color: var(--dataviz-namespace);
    border-width: 1px;
    border-radius: 6px;
    min-width: 100px;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 4px 0;
    margin: 4px 6px;
}

.processor-area {
    background-color: var(--dataviz-pane);
}

.processor-column-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding: 0;
    flex-shrink: 0;
    padding-bottom: 6px;
    background-color: var(--dataviz-pane);
    border-bottom-width: 1px;
    border-bottom-color: var(--dataviz-border);
}

.processor-list-scrollview {
    flex-grow: 1;
    padding: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--dataviz-border);
}

.horizontal-toggle {
    min-height: 24px;
    align-self: center;
    margin-top: 4px;
    margin-bottom: 4px;
    flex-direction: row;
    width: 200px;
}

.processor > .horizontal-toggle__container {
    height: 100%;
}


.horizontal-toggle__container {
    flex-grow: 1;
    height: 100%;
    border-color: var(--dataviz-border);
    border-width: 1px;
    flex-direction: row;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
}

.horizontal-toggle__label-container {
    flex-grow: 1;
    flex-direction: row;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
}

.horizontal-toggle__left-label,
.horizontal-toggle__right-label {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: center;
    align-items: center;
    align-content: center;
    align-self: center;
    -unity-text-align: middle-center;
}

.horizontal-toggle__left-label.unselected:hover,
.horizontal-toggle__right-label.unselected:hover {
    -unity-font-style: italic;
}

.horizontal-toggle__indicator {
    position: absolute;
    top: 0;
    height: 100%;
    border-radius: 6px;
}

.dataviz-root .horizontal-toggle__container {
    background-color: var(--dataviz-input);
}

.dataviz-root .horizontal-toggle__indicator {
    background-color: var(--dataviz-positive);
}

.dataviz-root .horizontal-toggle__left-label,
.dataviz-root .horizontal-toggle__right-label {
    color: var(--dataviz-muted);
    background-color: transparent;
}

.dataviz-root .horizontal-toggle__left-label.selected,
.dataviz-root .horizontal-toggle__right-label.selected {
    color: var(--dataviz-on-positive);
}

.dataviz-root .horizontal-toggle.dataviz-alternate-mode .horizontal-toggle__indicator {
    background-color: var(--dataviz-emphasis);
}

.dataviz-root .horizontal-toggle.dataviz-alternate-mode .horizontal-toggle__left-label.selected,
.dataviz-root .horizontal-toggle.dataviz-alternate-mode .horizontal-toggle__right-label.selected {
    color: var(--dataviz-on-emphasis);
}

.dataviz-root .horizontal-toggle__left-label.unselected:hover,
.dataviz-root .horizontal-toggle__right-label.unselected:hover {
    color: var(--dataviz-text);
}

.dataviz-root .horizontal-toggle:disabled {
    opacity: 0.5;
}

.dataviz-root .label-pill-remove-button,
.dataviz-root .label-pill-remove-button:hover,
.dataviz-root .label-pill-remove-button:active {
    background-color: transparent;
}

.dataviz-root .go-button-disabled {
    background-color: transparent;
    border-color: var(--dataviz-muted);
    color: var(--dataviz-muted);
}

.dataviz-root .processor-column {
    border-right-color: var(--dataviz-border);
}

/* Manual pagination was replaced by the virtualized object ListView; its page-controller styles
   are intentionally removed. */
