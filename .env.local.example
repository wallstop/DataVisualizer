# Data Visualizer — machine-local credential template.
#
# Copy to `.env.local` (gitignored) and fill in what you need:
#   cp .env.local.example .env.local
#
# `.env.local` is sourced by devcontainer shells automatically and self-loaded
# by the backend launchers (codex-zai, claude-zai, codex-openrouter,
# claude-openrouter) and MCP tooling (Unity bridge, Z.ai image server,
# configure.mjs). Variables already exported in the environment win over this
# file. Never commit it.
#
# Encoding matters: save as UTF-8 WITHOUT BOM and LF line endings. A BOM makes
# `source .env.local` fail in bash, silently dropping every key.

# ---------------------------------------------------------------------------
# Z.ai — GLM Coding Plan (https://docs.z.ai/devpack/overview)
# Used by: codex-zai / claude-zai launchers, zai-vision + zai-web-search MCP,
# zai-image generation MCP.
# Set either name: `npm run mcp:sync` mirrors whichever one you fill into the
# other (the official @z_ai MCP server reads Z_AI_API_KEY first).
ZAI_API_KEY=

# ---------------------------------------------------------------------------
# OpenRouter (https://openrouter.ai/keys) — unified gateway for Claude Code
# and Codex via the claude-openrouter / codex-openrouter launchers.
# Keys start with `sk-or-...`. OPEN_ROUTER_API_KEY is accepted as an alias.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# GitHub — PAT for the hosted GitHub MCP server (https://api.githubcopilot.com/mcp/)
# A classic PAT with `repo` scope covers public + private repo workflows.
# ---------------------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Context7 — optional API key (anonymous access works; a key lifts rate limits)
# https://context7.com/dashboard
# ---------------------------------------------------------------------------
CONTEXT7_API_KEY=

# ---------------------------------------------------------------------------
# Unity MCP bridge — shared token between Unity editors, host tooling, and
# devcontainer agents. `npm run mcp:sync` auto-generates a secure value if
# missing; keep host and container copies identical (same .env.local when the
# package folder is shared).
# ---------------------------------------------------------------------------
UNITY_MCP_TOKEN=

# Optional overrides (sensible defaults apply):
# UNITY_MCP_TCP_HOST=host.docker.internal   # how container agents reach host editors
# UNITY_MCP_BIND=loopback                   # or `all` (requires UNITY_MCP_TOKEN)
# UNITY_MCP_HTTP_PORT=9020                  # npm run unity:mcp:host HTTP bridge port
# UNITY_MCP_TIMEOUT_MS=30000                # editor command timeout

# ---------------------------------------------------------------------------
# Z.ai backend launcher overrides (optional):
# CODEX_ZAI_MODEL=glm-5.3
# CODEX_ZAI_REASONING_EFFORT=max            # low | high | max
# ZAI_API_TIMEOUT_MS=300000
# CLAUDE_ZAI_CONFIG_DIR=~/.claude-zai
# CLAUDE_ZAI_SONNET_MODEL=glm-5.3[1m]
# CLAUDE_ZAI_OPUS_MODEL=glm-5.3[1m]
# CLAUDE_ZAI_HAIKU_MODEL=glm-5.3-flash[1m]
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OpenRouter backend launcher overrides (optional):
# CODEX_OPENROUTER_MODEL=~openai/gpt-latest
# CODEX_OPENROUTER_REASONING_EFFORT=high    # low | medium | high | xhigh | max
# OPENROUTER_API_TIMEOUT_MS=300000
# CLAUDE_OPENROUTER_CONFIG_DIR=~/.claude-openrouter
# CLAUDE_OPENROUTER_FABLE_MODEL=~anthropic/claude-fable-latest
# CLAUDE_OPENROUTER_SONNET_MODEL=~anthropic/claude-sonnet-latest
# CLAUDE_OPENROUTER_OPUS_MODEL=~anthropic/claude-opus-latest
# CLAUDE_OPENROUTER_HAIKU_MODEL=~anthropic/claude-haiku-latest
# CLAUDE_OPENROUTER_SUBAGENT_MODEL=~anthropic/claude-opus-latest
# CLAUDE_OPENROUTER_GATEWAY_DISCOVERY=1     # 0 disables the /model picker
# ---------------------------------------------------------------------------
