{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DxVisualizer editor response v1",
  "type": "object",
  "required": ["schemaVersion", "status", "complete", "processedCount", "scopeCount", "availableCount", "offset", "items", "coverage"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": ["rejected", "running", "waiting", "cancelled", "complete", "failed"]
    },
    "code": {
      "type": ["string", "null"]
    },
    "detail": {
      "type": ["string", "null"]
    },
    "complete": {
      "type": "boolean",
      "description": "Work finished, not proof that every asset is valid or readable."
    },
    "processedCount": {
      "type": "integer",
      "minimum": 0
    },
    "scopeCount": {
      "type": "integer",
      "minimum": -1,
      "description": "-1 while query discovery is incomplete."
    },
    "availableCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Available catalog types, query records, validation findings, operation outcomes, or one configuration result."
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["guid", "path", "code"],
        "properties": {
          "guid": {
            "type": ["string", "null"]
          },
          "path": {
            "type": ["string", "null"]
          },
          "name": {
            "type": ["string", "null"]
          },
          "typeIdentity": {
            "type": ["string", "null"]
          },
          "labels": {
            "type": ["array", "null"],
            "items": {
              "type": "string"
            }
          },
          "code": {
            "type": ["string", "null"]
          },
          "propertyPath": {
            "type": ["string", "null"]
          },
          "detail": {
            "type": ["string", "null"]
          },
          "dataFolderPath": {
            "type": ["string", "null"],
            "description": "Proposed configuration in preview; actual preferences after read/apply."
          },
          "selectionMode": {
            "enum": ["keep", "select", null, ""],
            "description": "Configuration preference only; empty or null when no configuration value is available."
          },
          "sourceGuid": {
            "type": ["string", "null"],
            "description": "Original asset GUID; empty for create previews."
          },
          "destinationPath": {
            "type": ["string", "null"],
            "description": "Planned exact asset destination; empty for delete. path remains the original source path."
          }
        }
      }
    }
  }
}
