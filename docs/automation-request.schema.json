{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DxVisualizer editor request v1",
  "description": "Unknown members are ignored. The dispatcher enforces explicit scopes and confirmed mutation paths.",
  "type": "object",
  "required": ["schemaVersion", "operation"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "enum": [
        "catalog",
        "query",
        "validate",
        "previewProcessor",
        "applyProcessor",
        "readConfiguration",
        "previewConfiguration",
        "applyConfiguration",
        "previewAssets",
        "applyAssets"
      ]
    },
    "typeIdentities": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Query scopes, or exactly one type for processor operations. Assembly-qualified identities only."
    },
    "assetGuids": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "description": "Validate and processor operations: explicit nonempty main-asset scope."
    },
    "text": {
      "type": ["string", "null"]
    },
    "andLabels": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "orLabels": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "labelCombination": {
      "enum": ["and", "or", null, ""]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "processorIdentity": {
      "type": ["string", "null"],
      "description": "Processor operations only: concrete assembly-qualified IDataProcessor identity with a public parameterless constructor. Preview never constructs it."
    },
    "confirmPaths": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Apply only: processor paths, settings path, or every nonempty asset source/destination path in target order."
    },
    "settingsGuid": {
      "type": ["string", "null"],
      "pattern": "^([0-9a-fA-F]{32})?$",
      "description": "Configuration only: exact DataVisualizerSettings main-asset GUID under Assets."
    },
    "dataFolderPath": {
      "type": ["string", "null"],
      "description": "Configuration preview/apply: canonical existing Assets folder."
    },
    "selectionMode": {
      "enum": ["keep", "select", null, ""],
      "description": "Configuration preview/apply: keep preserves Unity selection; select selects inspected assets."
    },
    "assetOperation": {
      "enum": ["create", "clone", "rename", "move", "delete", null, ""]
    },
    "destinationPaths": {
      "type": ["array", "null"],
      "maxItems": 1000,
      "items": {
        "type": "string"
      },
      "description": "Asset create/clone/rename/move: one full destination path per target. Parent folders must exist. Delete accepts none."
    },
    "userStatePath": {
      "type": ["string", "null"],
      "description": "Configuration only: explicit JSON store outside protected project folders. Enables full state preferences."
    },
    "persistenceMode": {
      "enum": ["user", "settings", null, ""]
    },
    "themeGuid": {
      "type": ["string", "null"],
      "pattern": "^([0-9a-fA-F]{32})?$",
      "description": "Full configuration preview/apply: exact theme main GUID, or empty for default."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["readConfiguration", "previewConfiguration", "applyConfiguration"]
          }
        }
      },
      "then": {
        "required": ["settingsGuid"],
        "properties": {
          "settingsGuid": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{32}$"
          },
          "offset": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["previewConfiguration", "applyConfiguration"]
          }
        }
      },
      "then": {
        "required": ["dataFolderPath", "selectionMode"],
        "properties": {
          "dataFolderPath": {
            "type": "string",
            "minLength": 1
          },
          "selectionMode": {
            "enum": ["keep", "select"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "applyConfiguration"
          }
        }
      },
      "then": {
        "required": ["confirmPaths"],
        "properties": {
          "confirmPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["previewAssets", "applyAssets"]
          }
        }
      },
      "then": {
        "required": ["typeIdentities", "assetOperation"],
        "properties": {
          "typeIdentities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          },
          "assetOperation": {
            "enum": ["create", "clone", "rename", "move", "delete"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "applyAssets"
          }
        }
      },
      "then": {
        "required": ["confirmPaths"],
        "properties": {
          "confirmPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000
          }
        }
      }
    },
    {
      "if": {
        "required": ["userStatePath"],
        "properties": {
          "userStatePath": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "enum": ["readConfiguration", "previewConfiguration", "applyConfiguration"]
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "required": ["userStatePath"],
            "properties": {
              "userStatePath": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "properties": {
              "operation": {
                "enum": ["previewConfiguration", "applyConfiguration"]
              }
            }
          }
        ]
      },
      "then": {
        "required": ["persistenceMode", "themeGuid"],
        "properties": {
          "persistenceMode": {
            "enum": ["user", "settings"]
          },
          "themeGuid": {
            "type": "string",
            "pattern": "^([0-9a-fA-F]{32})?$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "applyConfiguration"
          }
        }
      },
      "then": {
        "if": {
          "required": ["userStatePath"],
          "properties": {
            "userStatePath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "then": {
          "properties": {
            "confirmPaths": {
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "else": {
          "properties": {
            "confirmPaths": {
              "maxItems": 1
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": ["persistenceMode"],
            "properties": {
              "persistenceMode": {
                "enum": ["user", "settings"]
              }
            }
          },
          {
            "required": ["themeGuid"],
            "properties": {
              "themeGuid": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "then": {
        "required": ["userStatePath"],
        "properties": {
          "userStatePath": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": ["readConfiguration", "previewConfiguration", "applyConfiguration"]
          }
        }
      }
    }
  ]
}
