{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DxVisualizer editor request v1",
  "description": "Unknown members are ignored. The dispatcher enforces explicit scopes and confirmed mutation paths.",
  "type": "object",
  "required": ["schemaVersion", "operation"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "enum": ["query", "validate", "previewProcessor", "applyProcessor", "readConfiguration", "previewConfiguration", "applyConfiguration"]
    },
    "typeIdentities": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Query scopes, or exactly one type for processor operations. Assembly-qualified identities only."
    },
    "assetGuids": {
      "type": ["array", "null"],
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{32}$"
      },
      "description": "Validate and processor operations: explicit nonempty main-asset scope."
    },
    "text": {
      "type": ["string", "null"]
    },
    "andLabels": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "orLabels": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "labelCombination": {
      "enum": ["and", "or", null, ""]
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "processorIdentity": {
      "type": ["string", "null"],
      "description": "Processor operations only: concrete assembly-qualified IDataProcessor identity with a public parameterless constructor. Preview never constructs it."
    },
    "confirmPaths": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      },
      "description": "Apply only: every processor target path in GUID order, or the single settings path from configuration preview."
    },
    "settingsGuid": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{32}$",
      "description": "Configuration only: exact DataVisualizerSettings main-asset GUID under Assets."
    },
    "dataFolderPath": {
      "type": ["string", "null"],
      "description": "Configuration preview/apply: canonical existing Assets folder."
    },
    "selectionMode": {
      "enum": ["keep", "select", null, ""],
      "description": "Configuration preview/apply: keep preserves Unity selection; select selects inspected assets."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["readConfiguration", "previewConfiguration", "applyConfiguration"]
          }
        }
      },
      "then": {
        "required": ["settingsGuid"],
        "properties": {
          "settingsGuid": {
            "type": "string"
          },
          "offset": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["previewConfiguration", "applyConfiguration"]
          }
        }
      },
      "then": {
        "required": ["dataFolderPath", "selectionMode"],
        "properties": {
          "dataFolderPath": {
            "type": "string",
            "minLength": 1
          },
          "selectionMode": {
            "enum": ["keep", "select"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "applyConfiguration"
          }
        }
      },
      "then": {
        "required": ["confirmPaths"],
        "properties": {
          "confirmPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ]
}
