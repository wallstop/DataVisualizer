{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DxVisualizer read-only request v1",
  "description": "Unknown members are ignored. The dispatcher enforces operation-specific scope rules. Mutation and configuration are unsupported.",
  "type": "object",
  "required": ["schemaVersion", "operation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "enum": ["query", "validate"] },
    "typeIdentities": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "Query only: nonempty assembly-qualified exact ScriptableObject type identities."
    },
    "assetGuids": {
      "type": ["array", "null"],
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
      "description": "Validate only: explicit nonempty main-asset scope."
    },
    "text": { "type": ["string", "null"] },
    "andLabels": { "type": ["array", "null"], "items": { "type": "string" } },
    "orLabels": { "type": ["array", "null"], "items": { "type": "string" } },
    "labelCombination": { "enum": ["and", "or", null, ""] },
    "offset": { "type": "integer", "minimum": 0, "default": 0 },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
  }
}
