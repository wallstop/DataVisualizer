{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallstop-studios.github.io/DataVisualizer/schemas/data-visualizer-automation-result.schema.json",
  "title": "Data Visualizer automation result",
  "type": "object",
  "required": ["schemaVersion", "operation", "succeeded", "complete"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": ["string", "null"] },
    "operation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "DataVisualizerAutomationRequestKind enum value."
    },
    "succeeded": { "type": "boolean" },
    "complete": { "type": "boolean" },
    "diagnostic": { "type": ["string", "null"] },
    "configuration": { "type": ["object", "null"] },
    "configurationJson": { "type": ["string", "null"] },
    "managedTypes": { "type": "array" },
    "metadata": { "type": ["object", "null"] },
    "assetOperation": { "$ref": "#/$defs/assetOperationResult" }
  },
  "$defs": {
    "assetOperationResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["preview", "succeeded", "complete", "items"],
      "properties": {
        "preview": { "type": "boolean" },
        "succeeded": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "diagnostic": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["succeeded"],
            "properties": {
              "guid": { "type": ["string", "null"] },
              "originalPath": { "type": ["string", "null"] },
              "resultingPath": { "type": ["string", "null"] },
              "resultingGuid": { "type": ["string", "null"] },
              "succeeded": { "type": "boolean" },
              "mutationApplied": { "type": "boolean" },
              "diagnostic": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
