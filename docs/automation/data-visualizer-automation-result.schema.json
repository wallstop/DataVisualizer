{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wallstop-studios.github.io/DataVisualizer/schemas/data-visualizer-automation-result.schema.json",
  "title": "Data Visualizer automation result",
  "type": "object",
  "required": ["schemaVersion", "succeeded", "complete"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": ["string", "null"] },
    "succeeded": { "type": "boolean" },
    "complete": { "type": "boolean" },
    "diagnostic": { "type": ["string", "null"] },
    "configuration": { "type": ["object", "null"] },
    "configurationJson": { "type": ["string", "null"] },
    "managedTypes": { "type": "array" },
    "metadata": { "type": ["object", "null"] },
    "assetOperation": { "type": ["object", "null"] }
  }
}
