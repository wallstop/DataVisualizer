{
  "name": "com.wallstop-studios.data-visualizer",
  "version": "0.1.0",
  "displayName": "DxVisualizer",
  "description": "Your game data, one window. Find, inspect, organize, and edit ScriptableObject data in one Unity editor window.",
  "unity": "2021.3",
  "keywords": [
    "DxVisualizer",
    "Dx",
    "Scriptable Object",
    "Scriptable Objects",
    "SO",
    "data",
    "editor window",
    "UI",
    "management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ambiguous-Interactive/DxVisualizer.git"
  },
  "bugs": {
    "url": "https://github.com/Ambiguous-Interactive/DxVisualizer/issues"
  },
  "author": "wallstop studios <wallstop@wallstopstudios.com> (https://wallstopstudios.com)",
  "homepage": "https://ambiguous-interactive.github.io/DxVisualizer/",
  "documentationUrl": "https://ambiguous-interactive.github.io/DxVisualizer/",
  "changelogUrl": "https://github.com/Ambiguous-Interactive/DxVisualizer/blob/main/CHANGELOG.md",
  "main": "README.md",
  "files": [
    "Editor",
    "Editor.meta",
    "Runtime",
    "Runtime.meta",
    "CHANGELOG.md",
    "CHANGELOG.md.meta",
    "README.md.meta",
    "LICENSE.meta",
    "package.json.meta"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:llm": "uv run scripts/lint_llm_instructions.py",
    "check:fast": "uv run scripts/fast_check.py",
    "check:gate": "uv run scripts/gate.py",
    "lint:llm:fix": "uv run scripts/lint_llm_instructions.py --fix",
    "lint:assembly-warnings": "uv run scripts/lint_assembly_warnings.py",
    "lint:csharp-member-order": "uv run scripts/lint_csharp_member_order.py",
    "lint:csharp-member-order:fix": "uv run scripts/lint_csharp_member_order.py --fix",
    "lint:csharp-null-assertions": "uv run scripts/lint_csharp_null_assertions.py",
    "lint:csharp-usings": "uv run scripts/lint_csharp_usings.py",
    "lint:csharp-usings:fix": "uv run scripts/lint_csharp_usings.py --fix",
    "lint:release-secrets": "uv run scripts/lint_release_secrets.py",
    "lint:line-endings": "uv run scripts/lint_line_endings.py",
    "lint:changelog-length": "uv run scripts/lint_changelog_length.py",
    "lint:llm:full": "uv run scripts/generate_skills_index.py && uv run scripts/lint_llm_instructions.py --verbose-output && uv run scripts/lint_file_lengths.py --verbose-output && uv run scripts/lint_csharp_member_order.py --verbose && uv run scripts/lint_release_secrets.py --verbose && uv run scripts/lint_line_endings.py --verbose && uv run scripts/lint_changelog_length.py --verbose && uv run scripts/tests/run_all.py",
    "mcp:sync": "node .llm/mcp/configure.mjs",
    "mcp:doctor": "node .llm/mcp/mcp-doctor.mjs",
    "mcp:repair": "node .llm/mcp/mcp-doctor.mjs --repair",
    "unity:mcp:host": "node .llm/mcp/unity-mcp-host.mjs",
    "unity:mcp:doctor": "node .llm/mcp/unity-mcp-doctor.mjs",
    "tools:install": "uv run .devcontainer/install_npm_tools.py",
    "ai:backends:install": "bash .devcontainer/ai-backends.sh install",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\""
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
